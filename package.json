{
  "name": "houserules-workspace",
  "version": "0.0.0",
  "author": "Devin T. Currie (https://github.com/DTCurrie)",
  "private": true,
  "description": "Workspace root for houserules and its first-party plugins. Not published.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DTCurrie/houserules.git"
  },
  "packageManager": "pnpm@11.20.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "wireit",
    "check": "wireit",
    "check:types": "wireit",
    "verify": "wireit",
    "test": "node scripts/capped-wireit.mjs test:all",
    "test:all": "wireit",
    "lint": "wireit",
    "lint:fix": "eslint . --fix",
    "lint:fix:paths": "eslint --fix",
    "schema": "pnpm --filter @houserules/cli schema",
    "format": "prettier --cache --write .",
    "format:paths": "prettier --cache --write",
    "format:check": "prettier --cache --check .",
    "change": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && node scripts/verify-package-manifests.mjs && node scripts/verify-tarballs.mjs && changeset publish",
    "dogfood": "pnpm --filter @houserules/cli dogfood",
    "dogfood:watch": "pnpm --filter @houserules/cli dogfood:watch",
    "attw": "wireit",
    "verify:package-manifests": "wireit",
    "verify:tarballs": "wireit",
    "verify:payload-copy-set": "wireit",
    "verify:payload-test-coverage": "wireit",
    "verify:payload-lib-declarations": "wireit",
    "verify:module-references": "wireit",
    "verify:checker-determinism": "wireit",
    "verify:payload-prose": "wireit",
    "verify:knip": "wireit",
    "test:scripts": "wireit",
    "verify:knip:audit": "knip --include files,dependencies,unlisted,unresolved,exports,nsExports,types,nsTypes,enumMembers,namespaceMembers,duplicates,cycles --include-entry-exports",
    "time-gate": "node scripts/time-gate.mjs"
  },
  "wireit": {
    "lint": {
      "//": "node_modules is excluded because packages/cli/test/plugin-fixture/node_modules/@houserules/cli symlinks back to packages/cli, and a glob that follows it recurses until wireit runs out of heap.",
      "command": "eslint --cache --cache-location .eslintcache .",
      "files": [
        "eslint.config.mjs",
        "packages/*/src/**/*.ts",
        "packages/*/test/**/*.ts",
        "packages/*/payload/**/*.mts",
        "packages/*/payload/**/__tests__/**/*.ts",
        "packages/*/scripts/**/*.mjs",
        "packages/*/*.ts",
        "scripts/**/*.mjs",
        "*.ts",
        "*.mjs",
        "packages/*/bin/**/*.mjs",
        "packages/*/test/**/*.cjs",
        "!**/node_modules/**"
      ],
      "output": []
    },
    "build": {
      "dependencies": [
        "./packages/api:build",
        "./packages/cli:build",
        "./packages/create:build",
        "./packages/payload:build",
        "./packages/plugin-accessibility:build",
        "./packages/plugin-backlog:build",
        "./packages/plugin-changesets:build",
        "./packages/plugin-decisions:build",
        "./packages/plugin-design:build",
        "./packages/plugin-github:build",
        "./packages/plugin-persona-auditor:build",
        "./packages/plugin-prose:build",
        "./packages/plugin-svelte:build",
        "./packages/plugin-testing:build",
        "./packages/plugin-three:build",
        "./packages/plugin-typescript:build",
        "./packages/test:build"
      ]
    },
    "check": {
      "//": "The local gate runs what CI runs. CI splits the same two halves across its lint and packages jobs.",
      "dependencies": [
        "check:types",
        "verify"
      ]
    },
    "verify": {
      "//": "Every post-build assertion `pnpm check` and CI share, listed once. CI runs `pnpm verify`, and `pnpm check` depends on it. `verify:tarballs` stays out, since it packs every package, and CI's packages job and `pnpm release` run it.",
      "dependencies": [
        "attw",
        "verify:package-manifests",
        "verify:payload-copy-set",
        "verify:payload-test-coverage",
        "verify:payload-lib-declarations",
        "verify:module-references",
        "verify:checker-determinism",
        "verify:payload-prose",
        "verify:knip"
      ]
    },
    "verify:package-manifests": {
      "command": "node scripts/verify-package-manifests.mjs",
      "files": [
        "scripts/verify-package-manifests.mjs",
        "scripts/lib/publishable-packages.mjs",
        "packages/*/package.json"
      ],
      "output": []
    },
    "verify:tarballs": {
      "command": "node scripts/verify-tarballs.mjs",
      "dependencies": [
        "build"
      ],
      "files": [
        "scripts/verify-tarballs.mjs",
        "scripts/lib/publishable-packages.mjs",
        "packages/*/package.json",
        "packages/*/README.md",
        "packages/*/LICENSE"
      ],
      "output": []
    },
    "verify:payload-copy-set": {
      "command": "node scripts/verify-payload-copy-set.mjs",
      "dependencies": [
        "build"
      ],
      "files": [
        "scripts/verify-payload-copy-set.mjs",
        "packages/*/package.json",
        "packages/*/payload/**",
        "!**/node_modules/**"
      ],
      "output": []
    },
    "verify:payload-test-coverage": {
      "command": "node scripts/verify-payload-test-coverage.mjs",
      "files": [
        "scripts/verify-payload-test-coverage.mjs",
        "packages/*/package.json",
        "packages/*/tsconfig.json",
        "packages/*/vitest.config.ts",
        "packages/*/payload/**/*.mts",
        "!**/node_modules/**"
      ],
      "output": []
    },
    "verify:payload-lib-declarations": {
      "command": "node scripts/verify-payload-lib-declarations.mjs",
      "dependencies": [
        "build"
      ],
      "files": [
        "scripts/verify-payload-lib-declarations.mjs",
        "packages/*/package.json",
        "packages/*/src/**/*.ts",
        "!**/node_modules/**"
      ],
      "output": []
    },
    "verify:module-references": {
      "command": "node scripts/verify-module-references.mjs",
      "dependencies": [
        "build"
      ],
      "files": [
        "scripts/verify-module-references.mjs",
        "packages/*/payload/**/*.md",
        "packages/*/payload/**/*.template",
        "packages/*/src/**/*.ts",
        "packages/*/package.json",
        "package.json",
        "pnpm-workspace.yaml",
        ".changeset/config.json",
        ".prettierrc.json",
        ".claude/houserules.config.json",
        ".claude/settings.json",
        "CLAUDE.md",
        "!**/node_modules/**"
      ],
      "output": []
    },
    "verify:checker-determinism": {
      "command": "node scripts/verify-checker-determinism.mjs",
      "dependencies": [
        "build"
      ],
      "files": [
        "scripts/verify-checker-determinism.mjs",
        "scripts/lib/**/*.mjs"
      ],
      "output": []
    },
    "verify:payload-prose": {
      "command": "node scripts/verify-payload-prose.mjs",
      "dependencies": [
        "./packages/plugin-prose:build",
        "./packages/payload:build"
      ],
      "files": [
        "scripts/verify-payload-prose.mjs",
        "scripts/lib/**/*.mjs",
        "packages/*/payload/**/*.mts",
        "packages/*/payload/**/*.md",
        "!**/node_modules/**"
      ],
      "output": []
    },
    "verify:knip": {
      "command": "knip --include files,dependencies,unlisted,unresolved,exports,nsExports,types,nsTypes,enumMembers,namespaceMembers,duplicates,cycles",
      "files": [
        "knip.ts",
        "package.json",
        "pnpm-workspace.yaml",
        "packages/*/package.json",
        "packages/*/src/**/*.ts",
        "packages/*/test/**/*.ts",
        "packages/*/payload/**/*.mts",
        "packages/*/payload/**/*.ts",
        "packages/*/scripts/**/*.mjs",
        "packages/*/*.ts",
        "scripts/**/*.mjs",
        "!**/node_modules/**"
      ],
      "output": []
    },
    "check:types": {
      "dependencies": [
        "./packages/api:check",
        "./packages/cli:check",
        "./packages/payload:check",
        "./packages/plugin-accessibility:check",
        "./packages/plugin-backlog:check",
        "./packages/plugin-changesets:check",
        "./packages/plugin-decisions:check",
        "./packages/plugin-design:check",
        "./packages/plugin-github:check",
        "./packages/plugin-persona-auditor:check",
        "./packages/plugin-prose:check",
        "./packages/plugin-svelte:check",
        "./packages/plugin-testing:check",
        "./packages/plugin-three:check",
        "./packages/plugin-typescript:check",
        "./packages/test:check"
      ]
    },
    "test:all": {
      "//": "Sixteen entries: fifteen packages plus the root scripts suite, not seventeen. @houserules/test ships no test script, and naming a script that does not exist is a wireit error, not a no-op the way `pnpm -r test` skipped them.",
      "dependencies": [
        "./packages/api:test",
        "./packages/cli:test",
        "./packages/payload:test",
        "./packages/plugin-accessibility:test",
        "./packages/plugin-backlog:test",
        "./packages/plugin-changesets:test",
        "./packages/plugin-decisions:test",
        "./packages/plugin-design:test",
        "./packages/plugin-github:test",
        "./packages/plugin-persona-auditor:test",
        "./packages/plugin-prose:test",
        "./packages/plugin-svelte:test",
        "./packages/plugin-testing:test",
        "./packages/plugin-three:test",
        "./packages/plugin-typescript:test",
        "test:scripts"
      ]
    },
    "test:scripts": {
      "command": "node --test scripts/__tests__/*.test.mjs scripts/bench/__tests__/*.test.mjs scripts/eval/__tests__/*.test.mjs",
      "dependencies": [
        "./packages/cli:build",
        "./packages/plugin-prose:build",
        "./packages/plugin-changesets:build"
      ],
      "files": [
        "scripts/__tests__/*.test.mjs",
        "scripts/verify-package-manifests.mjs",
        "scripts/lib/publishable-packages.mjs",
        "scripts/verify-payload-lib-declarations.mjs",
        "scripts/verify-module-references.mjs",
        "scripts/health-kit/gather/*.mjs",
        "scripts/health-kit/closeout/*.mjs",
        "scripts/bench/**/*.mjs",
        "scripts/eval/**/*.mjs",
        "scripts/time-gate.mjs",
        "scripts/health-kit/gather/SCHEMA.md",
        "scripts/bench/fixtures/**",
        "scripts/eval/fixtures/**",
        "packages/cli/payload/agents/phase-orchestrator.md",
        "packages/cli/src/commands/report/model-prices.ts",
        ".claude/scripts/**",
        ".claude/settings.json"
      ],
      "output": []
    },
    "attw": {
      "dependencies": [
        "./packages/api:attw",
        "./packages/cli:attw",
        "./packages/plugin-accessibility:attw",
        "./packages/plugin-backlog:attw",
        "./packages/plugin-changesets:attw",
        "./packages/plugin-decisions:attw",
        "./packages/plugin-design:attw",
        "./packages/plugin-github:attw",
        "./packages/plugin-persona-auditor:attw",
        "./packages/plugin-prose:attw",
        "./packages/plugin-svelte:attw",
        "./packages/plugin-testing:attw",
        "./packages/plugin-three:attw",
        "./packages/plugin-typescript:attw",
        "./packages/test:attw"
      ]
    }
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "knip": "^6.45.1",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "^8.73.0",
    "wireit": "catalog:"
  }
}
