{
  "name": "claude-kit",
  "version": "0.0.0",
  "description": "Interactive installer for a portable Claude Code context-discipline kit: hooks, skills, agents, changesets integration, and token-efficiency tooling.",
  "type": "module",
  "bin": {
    "claude-kit": "cli/index.mjs"
  },
  "files": [
    "cli",
    "payload",
    "kit.config.example.json",
    "CONVENTIONS.md"
  ],
  "scripts": {
    "test": "node --test",
    "lint": "eslint . --concurrency auto",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "change": "changeset",
    "dogfood": "node scripts/dogfood-link.mjs",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devintcurrie/claude-kit.git"
  },
  "keywords": [
    "claude",
    "claude-code",
    "agent",
    "hooks",
    "changesets",
    "tooling"
  ],
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.4"
  }
}
