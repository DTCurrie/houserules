{
  "name": "claude-kit-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace root for claude-kit and its first-party plugins. Not published.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "schema": "pnpm --filter @claude-kit/cli schema",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "change": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "dogfood": "pnpm --filter @claude-kit/cli dogfood",
    "dogfood:watch": "pnpm --filter @claude-kit/cli dogfood:watch"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
