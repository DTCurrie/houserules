{
  "name": "@agent-kit/test",
  "version": "0.0.0",
  "description": "agent-kit test: shared testing infrastructure for driving the agent-kit CLI against synthetic repos, for the CLI's own suites and for plugin authors.",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./repo": {
      "types": "./dist/repo.d.ts",
      "default": "./dist/repo.js"
    },
    "./run": {
      "types": "./dist/run.d.ts",
      "default": "./dist/run.js"
    },
    "./installed-tree": {
      "types": "./dist/installed-tree.d.ts",
      "default": "./dist/installed-tree.js"
    },
    "./doctor-report": {
      "types": "./dist/doctor-report.d.ts",
      "default": "./dist/doctor-report.js"
    },
    "./runner-stub": {
      "types": "./dist/runner-stub.d.ts",
      "default": "./dist/runner-stub.js"
    },
    "./global-setup": {
      "types": "./dist/global-setup.d.ts",
      "default": "./dist/global-setup.js"
    },
    "./hook-input": {
      "types": "./dist/hook-input.d.ts",
      "default": "./dist/hook-input.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@agent-kit/cli": "^0.1.0",
    "vitest": "^4.1.10"
  },
  "devDependencies": {
    "@agent-kit/cli": "workspace:*",
    "@types/node": "^26.1.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "license": "MIT",
  "keywords": [
    "agent-kit",
    "agent-kit-test"
  ]
}
