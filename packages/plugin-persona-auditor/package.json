{
  "name": "@claude-kit/plugin-persona-auditor",
  "version": "0.0.0",
  "description": "claude-kit plugin: a blind-rank-then-reconcile persona-auditor agent template.",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "payload-dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-payload.mjs",
    "check": "tsc --noEmit -p tsconfig.json",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@claude-kit/cli": "^0.1.0"
  },
  "devDependencies": {
    "@claude-kit/cli": "workspace:*",
    "@types/node": "^26.1.2",
    "typescript": "^6.0.3"
  },
  "license": "MIT",
  "keywords": [
    "claude-kit",
    "claude-kit-plugin"
  ]
}
