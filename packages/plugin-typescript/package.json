{
  "name": "@houserules/plugin-typescript",
  "version": "0.1.0",
  "description": "houserules plugin: a path-scoped TypeScript rule covering the type-system decisions that have a right answer.",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "payload-dist"
  ],
  "scripts": {
    "build": "wireit",
    "check": "wireit",
    "prepack": "npm run build",
    "test": "wireit",
    "attw": "wireit"
  },
  "wireit": {
    "build": {
      "command": "tsc -p tsconfig.build.json && houserules-payload && publint",
      "dependencies": [
        "../cli:build:ts",
        "../api:build"
      ],
      "files": [
        "src/**/*.ts",
        "!src/**/__test__/**",
        "tsconfig.build.json",
        "payload/**"
      ],
      "output": [
        "dist/**",
        "payload-dist/**"
      ]
    },
    "check": {
      "command": "tsc --noEmit -p tsconfig.json",
      "dependencies": [
        "../cli:build:ts",
        "../api:build",
        "../test:build"
      ],
      "files": [
        "src/**/*.ts",
        "tsconfig.json"
      ],
      "output": []
    },
    "test": {
      "command": "vitest run",
      "dependencies": [
        "build",
        "../test:build"
      ],
      "files": [
        "src/**/*.ts",
        "vitest.config.ts"
      ],
      "output": []
    },
    "attw": {
      "command": "attw --pack . --profile esm-only",
      "dependencies": [
        "build"
      ],
      "files": [
        "package.json"
      ],
      "output": []
    }
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DTCurrie/houserules.git",
    "directory": "packages/plugin-typescript"
  },
  "homepage": "https://github.com/DTCurrie/houserules/tree/main/packages/plugin-typescript#readme",
  "bugs": "https://github.com/DTCurrie/houserules/issues",
  "peerDependencies": {
    "@houserules/api": ">=0.0.0 <1.0.0"
  },
  "devDependencies": {
    "@houserules/api": "workspace:*",
    "@houserules/cli": "workspace:*",
    "@houserules/test": "workspace:*",
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^26.1.2",
    "publint": "^0.3.23",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "wireit": "^0.14.13"
  },
  "license": "MIT",
  "author": "Devin T. Currie (https://github.com/DTCurrie)",
  "keywords": [
    "houserules",
    "houserules-plugin",
    "typescript",
    "claude-code"
  ]
}
