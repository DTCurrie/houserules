{
  "name": "@agent-kit/plugin-testing",
  "version": "0.0.0",
  "description": "agent-kit plugin: a runner-agnostic testing rule, split into opt-in per-language guides.",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "payload-dist"
  ],
  "scripts": {
    "build": "rm -rf dist payload-dist && tsc -p tsconfig.json && node scripts/build-payload.mjs",
    "check": "tsc --noEmit -p tsconfig.json",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@agent-kit/cli": "^0.1.0"
  },
  "devDependencies": {
    "@agent-kit/cli": "workspace:*",
    "@types/node": "^26.1.2",
    "typescript": "^6.0.3"
  },
  "license": "MIT",
  "keywords": [
    "agent-kit",
    "agent-kit-plugin"
  ]
}
