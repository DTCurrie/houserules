{
  "name": "@agent-kit/cli",
  "version": "0.0.0",
  "description": "agent-kit: an interactive installer for a portable Claude Code context-discipline kit: hooks, skills, agents, changesets integration, and token-efficiency tooling.",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "agent-kit": "bin/agent-kit.mjs",
    "agent-kit-payload": "bin/agent-kit-payload.mjs"
  },
  "files": [
    "bin",
    "dist",
    "payload-dist",
    "!payload-dist/scripts/lib/**",
    "schema",
    "kit.config.example.json",
    "CONVENTIONS.md"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./schema": "./schema/kit.config.schema.json"
  },
  "scripts": {
    "build": "wireit",
    "schema": "wireit",
    "check": "wireit",
    "test": "wireit",
    "attw": "wireit",
    "test:watch": "wireit",
    "dogfood": "wireit",
    "prepack": "npm run build",
    "build:payload": "wireit",
    "build:ts": "wireit",
    "dogfood:watch": "WIREIT_WATCH=true npm run dogfood"
  },
  "wireit": {
    "build": {
      "command": "publint",
      "dependencies": [
        "schema"
      ],
      "files": [
        "package.json",
        "bin/**",
        "kit.config.example.json",
        "CONVENTIONS.md"
      ],
      "output": []
    },
    "attw": {
      "command": "attw --pack . --profile esm-only",
      "dependencies": [
        "build"
      ],
      "files": [
        "package.json",
        "bin/**"
      ],
      "output": []
    },
    "build:payload": {
      "command": "tsc -p tsconfig.payload.json && node scripts/build-payload.mjs",
      "dependencies": [
        "../payload:build"
      ],
      "files": [
        "payload/**",
        "!payload/**/__test__/**",
        "tsconfig.payload.json",
        "scripts/build-payload.mjs"
      ],
      "output": [
        "payload-dist/**"
      ]
    },
    "build:ts": {
      "command": "tsc -p tsconfig.build.json",
      "dependencies": [
        "build:payload"
      ],
      "files": [
        "src/**/*.ts",
        "!src/**/__test__/**",
        "tsconfig.build.json"
      ],
      "output": [
        "dist/**"
      ]
    },
    "schema": {
      "command": "node scripts/generate-schema.mjs",
      "dependencies": [
        "build:ts"
      ],
      "files": [
        "scripts/generate-schema.mjs",
        "../../.prettierrc.json"
      ],
      "output": [
        "schema/kit.config.schema.json"
      ]
    },
    "check": {
      "command": "tsc --noEmit -p tsconfig.json",
      "dependencies": [
        "build:payload",
        "../test:build"
      ],
      "files": [
        "src/**/*.ts",
        "test/**/*.ts",
        "!test/**/node_modules/**",
        "payload/**/__test__/**/*.ts",
        "tsconfig.json"
      ],
      "output": []
    },
    "test": {
      "command": "vitest run",
      "dependencies": [
        "build:ts",
        "build:payload",
        "../test:build"
      ],
      "files": [
        "src/**/*.ts",
        "test/**",
        "!test/**/node_modules/**",
        "payload/**",
        "vitest.config.ts",
        "kit.config.example.json"
      ],
      "output": []
    },
    "test:watch": {
      "command": "vitest",
      "dependencies": [
        "build:ts",
        "build:payload",
        "../test:build"
      ]
    },
    "dogfood": {
      "//": "No `output`. This writes into the repo root's .claude/, outside the package, and wireit rejects output paths that escape the package directory. With `files` and no `output` it re-runs whenever an input changes, which is what WIREIT_WATCH wants. It shells out to the real installer (`dist/cli.js init`), so every package it loads as a plugin has to be built first, and every package's `package.json` feeds the `targets` array the script derives.",
      "command": "node scripts/dogfood-link.mjs",
      "dependencies": [
        "build:ts",
        "../plugin-accessibility:build",
        "../plugin-backlog:build",
        "../plugin-changesets:build",
        "../plugin-decisions:build",
        "../plugin-design:build",
        "../plugin-prose:build",
        "../plugin-svelte:build",
        "../plugin-testing:build",
        "../plugin-three:build",
        "../plugin-typescript:build"
      ],
      "files": [
        "scripts/dogfood-link.mjs",
        "../*/package.json"
      ]
    }
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DTCurrie/agent-kit.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/DTCurrie/agent-kit/tree/main/packages/cli#readme",
  "bugs": "https://github.com/DTCurrie/agent-kit/issues",
  "keywords": [
    "claude",
    "claude-code",
    "agent",
    "hooks",
    "changesets",
    "tooling",
    "agent-kit"
  ],
  "license": "MIT",
  "author": "Devin T. Currie (https://github.com/DTCurrie)",
  "dependencies": {
    "@agent-kit/payload": "workspace:*",
    "@clack/prompts": "^0.11.0",
    "commander": "^15.0.0",
    "dequal": "^2.0.3",
    "diff": "^9.0.0",
    "picocolors": "^1.1.1",
    "semver": "^7.8.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@agent-kit/test": "workspace:*",
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@types/semver": "^7.8.0",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "publint": "^0.3.23",
    "type-fest": "^5.8.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10",
    "wireit": "^0.14.13"
  }
}
