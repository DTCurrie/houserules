{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/devintcurrie/claude-kit/schema/kit.config.schema.json",
  "title": "claude-kit config",
  "description": "Per-repo configuration for claude-kit (.claude/kit.config.json).",
  "type": "object",
  "properties": {
    "_help": { "type": "string" },
    "_notes": {
      "type": "object",
      "propertyNames": { "type": "string" },
      "additionalProperties": { "type": "string" }
    },
    "$schema": { "type": "string" },
    "version": {
      "type": "number",
      "const": 2,
      "description": "Config schema version."
    },
    "packageManager": { "type": "string", "minLength": 1 },
    "fix": {
      "type": "object",
      "properties": {
        "runner": {
          "type": "string",
          "minLength": 1,
          "description": "Package manager binary, e.g. \"pnpm\"."
        },
        "filterFlag": {
          "type": "string",
          "description": "Workspace filter flag, e.g. \"--filter\". Empty for a single-package repo."
        },
        "runScriptPrefix": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Argv between the runner and the script name, e.g. [\"run\"]."
        },
        "commands": {
          "type": "array",
          "items": { "type": "string" },
          "description": "package.json scripts to run, in order."
        },
        "onSubagentStop": {
          "description": "Run the fixer when a SUBAGENT stops. Off by default: parallel workers would each fix every package at once.",
          "type": "boolean"
        },
        "commandExtensions": {
          "description": "Per-fix-command file extensions, e.g. {\"lint:fix\": [\"ts\",\"tsx\"]}. Narrows which changed files trigger which fixer.",
          "type": "object",
          "propertyNames": { "type": "string" },
          "additionalProperties": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "required": ["runner", "filterFlag", "runScriptPrefix", "commands"],
      "additionalProperties": false
    },
    "verify": {
      "description": "Only present when the verify-changed module is enabled.",
      "type": "object",
      "properties": {
        "runner": {
          "type": "string",
          "minLength": 1,
          "description": "Package manager binary, e.g. \"pnpm\"."
        },
        "filterFlag": {
          "type": "string",
          "description": "Workspace filter flag, e.g. \"--filter\". Empty for a single-package repo."
        },
        "runScriptPrefix": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Argv between the runner and the script name, e.g. [\"run\"]."
        },
        "commands": {
          "type": "array",
          "items": { "type": "string" },
          "description": "package.json scripts to run, in order."
        },
        "baseBranch": {
          "description": "Branch the changed-file diff is taken against. Defaults to changesets.baseBranch, then \"main\".",
          "type": "string"
        }
      },
      "required": ["runner", "filterFlag", "runScriptPrefix", "commands"],
      "additionalProperties": false
    },
    "lintableExtensions": { "type": "array", "items": { "type": "string" } },
    "generatedFilePattern": {
      "description": "Regex source; files matching it are never auto-fixed.",
      "type": "string"
    },
    "guard": {
      "type": "object",
      "properties": {
        "gitCommit": { "type": "boolean" },
        "gitPush": { "type": "boolean" },
        "gitStash": { "type": "boolean" },
        "prCreate": { "type": "boolean" },
        "custom": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "pattern": { "type": "string" },
              "message": { "type": "string" }
            },
            "required": ["pattern", "message"],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "changesets": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "stopCheck": { "type": "boolean" },
        "baseBranch": { "type": "string" }
      },
      "additionalProperties": false
    },
    "ledger": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" } },
      "additionalProperties": false
    },
    "decisions": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" } },
      "additionalProperties": false
    },
    "claudeMd": {
      "type": "object",
      "properties": {
        "managed": {
          "description": "Let the kit maintain its marked block in CLAUDE.md. Set false to opt out; the kit then never touches the file.",
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "readGuard": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "maxBytes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "denyGlobs": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "scripts": {
      "type": "object",
      "properties": {
        "commit": {
          "description": "Keep .claude/scripts/ committed instead of gitignored. Off by default: the scripts are build output, refreshed by `npx claude-kit update`.",
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "plugins": {
      "description": "Plugins contributing extra modules, resolved in this order.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "npm package name, or a repo-relative path to a directory holding a package.json."
          },
          "alias": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "description": "Id namespace for this plugin's modules. A module `prose-voice` under alias `voice` is selected as \"voice/prose-voice\"."
          },
          "config": {
            "description": "Passed to the plugin verbatim. The kit never reads inside it."
          }
        },
        "required": ["name", "alias"],
        "additionalProperties": false
      }
    },
    "moduleOptions": {
      "description": "Per-module option selections, keyed by module id. Persisted so update and doctor never have to ask again.",
      "type": "object",
      "propertyNames": { "type": "string" },
      "additionalProperties": { "type": "array", "items": { "type": "string" } }
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Kebab short name; used in generated filenames."
          },
          "prefix": {
            "type": "string",
            "minLength": 1,
            "description": "Uppercase backlog-id prefix, e.g. \"CORE\"."
          },
          "packageName": {
            "type": "string",
            "description": "package.json name, or \".\" for a rootless repo."
          },
          "pathPrefix": {
            "type": "string",
            "description": "Repo-relative dir with a trailing slash; \"\" for a single-package repo."
          },
          "sourcePath": {
            "type": "string",
            "description": "Where this target's source lives."
          },
          "label": {
            "type": "string",
            "description": "Human label, e.g. \"Core\"."
          },
          "fixCommands": {
            "description": "Per-target override of fix.commands — real repos diverge.",
            "anyOf": [
              { "type": "array", "items": { "type": "string" } },
              { "type": "null" }
            ]
          },
          "verifyCommands": {
            "description": "Per-target override of verify.commands.",
            "anyOf": [
              { "type": "array", "items": { "type": "string" } },
              { "type": "null" }
            ]
          },
          "changelogPath": {
            "description": "Ledger module only.",
            "type": "string"
          },
          "logPath": { "description": "Ledger module only.", "type": "string" },
          "regen": {
            "description": "Regen module: re-run `command` when a file matching `sourceGlob` is edited.",
            "type": "object",
            "properties": {
              "sourceGlob": { "type": "string" },
              "command": { "type": "string" }
            },
            "required": ["sourceGlob", "command"],
            "additionalProperties": false
          }
        },
        "required": [
          "name",
          "prefix",
          "packageName",
          "pathPrefix",
          "sourcePath",
          "label"
        ],
        "additionalProperties": false
      },
      "description": "The packages/areas the kit tracks."
    }
  },
  "required": ["version", "packageManager", "targets"],
  "additionalProperties": false
}
