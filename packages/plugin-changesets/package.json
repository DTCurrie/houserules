{
  "name": "@agent-kit/plugin-changesets",
  "version": "0.0.0",
  "description": "agent-kit plugin: changesets integration (canonical changelog) and the optional per-commit changelog ledger.",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "payload-dist"
  ],
  "scripts": {
    "build": "rm -rf dist payload-dist && tsc -p tsconfig.json && tsc -p tsconfig.payload.json && node scripts/build-payload.mjs",
    "check": "tsc --noEmit -p tsconfig.json",
    "prepack": "npm run build",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DTCurrie/agent-kit.git",
    "directory": "packages/plugin-changesets"
  },
  "homepage": "https://github.com/DTCurrie/agent-kit/tree/main/packages/plugin-changesets#readme",
  "bugs": "https://github.com/DTCurrie/agent-kit/issues",
  "peerDependencies": {
    "@agent-kit/cli": "^0.1.0"
  },
  "devDependencies": {
    "@agent-kit/cli": "workspace:*",
    "@agent-kit/test": "workspace:*",
    "@types/node": "^26.1.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "license": "MIT",
  "keywords": [
    "agent-kit",
    "agent-kit-plugin",
    "claude-code",
    "changesets",
    "changelog",
    "release",
    "semver"
  ]
}
