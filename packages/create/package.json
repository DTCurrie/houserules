{
  "name": "@houserules/create",
  "version": "0.1.2",
  "description": "Initializer for @houserules/cli: `npm create @houserules` adds the cli to the repo and runs init.",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "create-houserules": "bin/create-houserules.mjs"
  },
  "files": [
    "bin"
  ],
  "scripts": {
    "build": "wireit",
    "prepack": "npm run build"
  },
  "wireit": {
    "build": {
      "command": "publint",
      "files": [
        "package.json",
        "bin/**"
      ],
      "output": []
    }
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DTCurrie/houserules.git",
    "directory": "packages/create"
  },
  "homepage": "https://github.com/DTCurrie/houserules/tree/main/packages/create#readme",
  "bugs": "https://github.com/DTCurrie/houserules/issues",
  "dependencies": {
    "@houserules/cli": "workspace:^"
  },
  "devDependencies": {
    "publint": "catalog:",
    "wireit": "catalog:"
  },
  "license": "MIT",
  "author": "Devin T. Currie (https://github.com/DTCurrie)",
  "keywords": [
    "houserules",
    "claude-code",
    "create"
  ]
}
