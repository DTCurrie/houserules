{
  "extends": "./tsconfig.payload.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    // Mirrors the `#test/*` alias in vitest.config.ts so `tsc --noEmit` resolves it, to
    // @houserules/test's published subpaths.
    "paths": {
      "#test/*": ["./node_modules/@houserules/test/dist/*.d.ts"]
    }
  },
  // tsconfig.payload.json excludes colocated tests so they stay out of payload-dist/.
  // Typechecking must still see them, so the inherited exclude is cleared here.
  "exclude": [],
  "include": ["payload/**/*.mts", "payload/**/__tests__/**/*.ts"]
}
