{
  "name": "@agent-kit/payload",
  "version": "0.0.0",
  "description": "agent-kit: shared payload libraries, copied into .claude/scripts/lib and executed on bare node with zero runtime dependencies.",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "payload-dist"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./*": {
      "types": "./payload-dist/scripts/lib/*.d.mts",
      "default": "./payload-dist/scripts/lib/*.mjs"
    }
  },
  "scripts": {
    "build": "wireit",
    "check": "wireit",
    "test": "wireit",
    "prepack": "npm run build"
  },
  "wireit": {
    "build": {
      "command": "tsc -p tsconfig.payload.json && publint",
      "files": [
        "payload/**",
        "!payload/**/__test__/**",
        "tsconfig.payload.json"
      ],
      "output": [
        "payload-dist/**"
      ]
    },
    "check": {
      "command": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.payload.json",
      "dependencies": [
        "../test:build"
      ],
      "files": [
        "payload/**/*.mts",
        "payload/**/__test__/**/*.ts",
        "tsconfig.json",
        "tsconfig.payload.json"
      ],
      "output": []
    },
    "test": {
      "command": "vitest run",
      "dependencies": [
        "../test:build"
      ],
      "files": [
        "payload/**",
        "vitest.config.ts"
      ],
      "output": []
    }
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DTCurrie/agent-kit.git",
    "directory": "packages/payload"
  },
  "homepage": "https://github.com/DTCurrie/agent-kit/tree/main/packages/payload#readme",
  "bugs": "https://github.com/DTCurrie/agent-kit/issues",
  "license": "MIT",
  "author": "Devin T. Currie (https://github.com/DTCurrie)",
  "keywords": [
    "agent-kit",
    "claude-code",
    "hooks"
  ],
  "devDependencies": {
    "@agent-kit/test": "workspace:*",
    "@types/node": "^26.2.0",
    "publint": "^0.3.23",
    "type-fest": "^5.8.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "wireit": "^0.14.13"
  }
}
