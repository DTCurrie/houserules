{
  "name": "@houserules/plugin-svelte",
  "version": "0.1.2",
  "description": "houserules plugin: Svelte 5 authoring conventions, an opt-in SvelteKit guide, and the Svelte MCP server config.",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "payload-dist"
  ],
  "scripts": {
    "build": "wireit",
    "check": "wireit",
    "prepack": "npm run build",
    "test": "wireit",
    "attw": "wireit"
  },
  "wireit": {
    "build": {
      "command": "tsc -p tsconfig.build.json && tsc -p tsconfig.payload.json && houserules-payload && publint",
      "dependencies": [
        "../cli:build:ts",
        "../api:build",
        "../payload:build"
      ],
      "files": [
        "src/**/*.ts",
        "!src/**/__tests__/**",
        "tsconfig.build.json",
        "payload/**",
        "!payload/**/__tests__/**",
        "tsconfig.payload.json"
      ],
      "output": [
        "dist/**",
        "payload-dist/**"
      ]
    },
    "check": {
      "command": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.payload.json",
      "dependencies": [
        "../cli:build:ts",
        "../api:build",
        "../test:build",
        "../payload:build"
      ],
      "files": [
        "src/**/*.ts",
        "tsconfig.json",
        "tsconfig.build.json",
        "payload/**/*.mts",
        "payload/**/__tests__/**",
        "tsconfig.payload.json"
      ],
      "output": []
    },
    "test": {
      "command": "vitest run",
      "dependencies": [
        "build",
        "../test:build"
      ],
      "files": [
        "src/**/*.ts",
        "vitest.config.ts",
        "payload/**"
      ],
      "output": []
    },
    "attw": {
      "command": "attw --pack . --profile esm-only",
      "dependencies": [
        "build"
      ],
      "files": [
        "package.json"
      ],
      "output": []
    }
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DTCurrie/houserules.git",
    "directory": "packages/plugin-svelte"
  },
  "homepage": "https://github.com/DTCurrie/houserules/tree/main/packages/plugin-svelte#readme",
  "bugs": "https://github.com/DTCurrie/houserules/issues",
  "peerDependencies": {
    "@houserules/api": ">=0.0.0 <1.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@houserules/api": "workspace:*",
    "@houserules/cli": "workspace:*",
    "@houserules/payload": "workspace:*",
    "@houserules/test": "workspace:*",
    "@types/node": "catalog:",
    "publint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wireit": "catalog:"
  },
  "license": "MIT",
  "author": "Devin T. Currie (https://github.com/DTCurrie)",
  "keywords": [
    "houserules",
    "houserules-plugin",
    "svelte",
    "claude-code"
  ],
  "dependencies": {},
  "optionalDependencies": {}
}
